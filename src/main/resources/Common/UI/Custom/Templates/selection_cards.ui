$C = "../../Common.ui";

// Template para Cards de Seleção de Raça
@RaceCard {
  LayoutMode: Left;
  Anchor: (Height: 75, Bottom: 8);
  Padding: (Full: 12);
  Background: #1a1a1a(0.7);
  BorderWidth: 2;
  BorderColor: #404040(0.4);
  CornerRadius: 6;
  Style: (
    Hovered: (Background: #2a2a2a(0.85), BorderColor: #606060(0.7)),
    Pressed: (Background: #3a3a3a(0.95), BorderColor: #808080(0.9)),
    Selected: (Background: #2d4050(0.9), BorderColor: #4d8ac0(1.0), BorderWidth: 3)
  );

  Group #IconContainer {
    Anchor: (Width: 52, Height: 52);
    LayoutMode: MiddleCenter;
    Background: #0f0f0f(0.8);
    BorderWidth: 1;
    BorderColor: #3a3a3a(0.6);
    CornerRadius: 4;

    Label #RaceIcon {
      Alignment: Center;
      Style: (FontSize: 32);
      Text: "🧝";
    }
  }

  Group #Info {
    LayoutMode: Top;
    Padding: (Left: 12);
    FlexWeight: 1;

    Label #RaceName {
      Anchor: (Height: 20);
      Style: (FontSize: 15, RenderBold: true, TextColor: #ffffff);
      Text: "Elf";
    }

    Label #RaceTagline {
      Anchor: (Height: 16, Top: 2);
      Style: (FontSize: 11, TextColor: #999999);
      Text: "Swift and graceful";
    }

    Group #RaceTags {
      LayoutMode: Left;
      Anchor: (Height: 14, Top: 4);

      Label #Tag1 {
        Anchor: (Right: 6);
        Padding: (Horizontal: 6, Vertical: 2);
        Background: #2a4a2a(0.6);
        CornerRadius: 3;
        Style: (FontSize: 9, TextColor: #88ff88);
        Text: "AGI +3";
      }

      Label #Tag2 {
        Padding: (Horizontal: 6, Vertical: 2);
        Background: #4a2a2a(0.6);
        CornerRadius: 3;
        Style: (FontSize: 9, TextColor: #ff8888);
        Text: "STR -1";
      }
    }
  }

  Group #SelectIndicator {
    Anchor: (Width: 24, Height: 24);
    LayoutMode: MiddleCenter;
    Background: #2d7b4c(0.0);
    BorderWidth: 2;
    BorderColor: #4a4a4a(0.5);
    CornerRadius: 12;
    Style: (
      Selected: (Background: #2d7b4c(0.9), BorderColor: #4d9b6c(1.0))
    );

    Label #CheckMark {
      Alignment: Center;
      Style: (FontSize: 14, TextColor: #ffffff);
      Text: "";
      Style: (
        Selected: (Text: "✓")
      );
    }
  }
}

// Template para Cards de Seleção de Classe
@ClassCard {
  LayoutMode: Left;
  Anchor: (Height: 75, Bottom: 8);
  Padding: (Full: 12);
  Background: #1a1a1a(0.7);
  BorderWidth: 2;
  BorderColor: #404040(0.4);
  CornerRadius: 6;
  Style: (
    Hovered: (Background: #2a2a2a(0.85), BorderColor: #606060(0.7)),
    Pressed: (Background: #3a3a3a(0.95), BorderColor: #808080(0.9)),
    Selected: (Background: #402d20(0.9), BorderColor: #c08a4d(1.0), BorderWidth: 3)
  );

  Group #IconContainer {
    Anchor: (Width: 52, Height: 52);
    LayoutMode: MiddleCenter;
    Background: #0f0f0f(0.8);
    BorderWidth: 1;
    BorderColor: #3a3a3a(0.6);
    CornerRadius: 4;

    Label #ClassIcon {
      Alignment: Center;
      Style: (FontSize: 32);
      Text: "⚔️";
    }
  }

  Group #Info {
    LayoutMode: Top;
    Padding: (Left: 12);
    FlexWeight: 1;

    Label #ClassName {
      Anchor: (Height: 20);
      Style: (FontSize: 15, RenderBold: true, TextColor: #ffffff);
      Text: "Warrior";
    }

    Label #ClassTagline {
      Anchor: (Height: 16, Top: 2);
      Style: (FontSize: 11, TextColor: #999999);
      Text: "Master of combat";
    }

    Group #ClassTags {
      LayoutMode: Left;
      Anchor: (Height: 14, Top: 4);

      Label #Tag1 {
        Anchor: (Right: 6);
        Padding: (Horizontal: 6, Vertical: 2);
        Background: #4a2a2a(0.6);
        CornerRadius: 3;
        Style: (FontSize: 9, TextColor: #ffaa88);
        Text: "MELEE";
      }

      Label #Tag2 {
        Padding: (Horizontal: 6, Vertical: 2);
        Background: #2a3a4a(0.6);
        CornerRadius: 3;
        Style: (FontSize: 9, TextColor: #88aaff);
        Text: "TANK";
      }
    }
  }

  Group #SelectIndicator {
    Anchor: (Width: 24, Height: 24);
    LayoutMode: MiddleCenter;
    Background: #2d7b4c(0.0);
    BorderWidth: 2;
    BorderColor: #4a4a4a(0.5);
    CornerRadius: 12;
    Style: (
      Selected: (Background: #2d7b4c(0.9), BorderColor: #4d9b6c(1.0))
    );

    Label #CheckMark {
      Alignment: Center;
      Style: (FontSize: 14, TextColor: #ffffff);
      Text: "";
      Style: (
        Selected: (Text: "✓")
      );
    }
  }
}

// Exemplo de Lista Completa de Raças
@RaceListExample {
  LayoutMode: Top;

  $C.@RaceCard #HumanCard {
    #RaceIcon { Text: "👤"; }
    #RaceName { Text: "Human"; }
    #RaceTagline { Text: "Balanced and versatile"; }
    #Tag1 { Text: "BAL"; Background: #3a3a4a(0.6); }
    #Tag2 { Text: "ADAPT"; Background: #3a4a3a(0.6); }
  }

  $C.@RaceCard #ElfCard {
    #RaceIcon { Text: "🧝"; }
    #RaceName { Text: "Elf"; }
    #RaceTagline { Text: "Swift and graceful"; }
    #Tag1 { Text: "AGI +3"; }
    #Tag2 { Text: "STR -1"; }
  }

  $C.@RaceCard #DwarfCard {
    #RaceIcon { Text: "🧔"; }
    #RaceName { Text: "Dwarf"; }
    #RaceTagline { Text: "Strong and resilient"; }
    #Tag1 { Text: "STR +2"; }
    #Tag2 { Text: "SPD -1"; }
  }

  $C.@RaceCard #OrcCard {
    #RaceIcon { Text: "👹"; }
    #RaceName { Text: "Orc"; }
    #RaceTagline { Text: "Fierce warrior"; }
    #Tag1 { Text: "ATK +4"; }
    #Tag2 { Text: "INT -2"; }
  }

  $C.@RaceCard #FairyCard {
    #RaceIcon { Text: "🧚"; }
    #RaceName { Text: "Fairy"; }
    #RaceTagline { Text: "Magical and nimble"; }
    #Tag1 { Text: "MAG +3"; }
    #Tag2 { Text: "DEF -2"; }
  }
}

// Exemplo de Lista Completa de Classes
@ClassListExample {
  LayoutMode: Top;

  $C.@ClassCard #WarriorCard {
    #ClassIcon { Text: "⚔️"; }
    #ClassName { Text: "Warrior"; }
    #ClassTagline { Text: "Master of combat"; }
    #Tag1 { Text: "MELEE"; }
    #Tag2 { Text: "TANK"; }
  }

  $C.@ClassCard #MageCard {
    #ClassIcon { Text: "🔮"; }
    #ClassName { Text: "Mage"; }
    #ClassTagline { Text: "Arcane spellcaster"; }
    #Tag1 { Text: "MAGIC"; Background: #2a2a4a(0.6); TextColor: #aaaaff; }
    #Tag2 { Text: "RANGED"; }
  }

  $C.@ClassCard #RogueCard {
    #ClassIcon { Text: "🗡️"; }
    #ClassName { Text: "Rogue"; }
    #ClassTagline { Text: "Silent assassin"; }
    #Tag1 { Text: "STEALTH"; Background: #2a2a2a(0.6); TextColor: #aaaaaa; }
    #Tag2 { Text: "CRIT"; Background: #4a2a2a(0.6); TextColor: #ffaa88; }
  }

  $C.@ClassCard #PaladinCard {
    #ClassIcon { Text: "🛡️"; }
    #ClassName { Text: "Paladin"; }
    #ClassTagline { Text: "Holy protector"; }
    #Tag1 { Text: "HYBRID"; Background: #4a4a2a(0.6); TextColor: #ffffaa; }
    #Tag2 { Text: "SUPPORT"; Background: #2a4a2a(0.6); TextColor: #aaffaa; }
  }

  $C.@ClassCard #RangerCard {
    #ClassIcon { Text: "🏹"; }
    #ClassName { Text: "Ranger"; }
    #ClassTagline { Text: "Expert marksman"; }
    #Tag1 { Text: "RANGED"; }
    #Tag2 { Text: "DPS"; Background: #4a2a2a(0.6); TextColor: #ffaa88; }
  }

  $C.@ClassCard #NecromancerCard {
    #ClassIcon { Text: "💀"; }
    #ClassName { Text: "Necromancer"; }
    #ClassTagline { Text: "Master of undeath"; }
    #Tag1 { Text: "DARK"; Background: #2a2a2a(0.6); TextColor: #cc88ff; }
    #Tag2 { Text: "SUMMONER"; Background: #2a2a4a(0.6); TextColor: #aaaaff; }
  }
}
