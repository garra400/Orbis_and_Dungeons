$C = "../../Common.ui";

$C.@PageOverlay {
  $C.@DecoratedContainer #Container {
    LayoutMode: Top;
    Anchor: (Width: 950, Height: 650);

    Group #Header {
      LayoutMode: MiddleCenter;
      Anchor: (Height: 80);
      Padding: (Full: 15);
      Background: #0a0a0a(0.5);

      Label #Title {
        Alignment: Center;
        Style: (FontSize: 28, RenderBold: true, TextColor: #f0e68c);
        Text: "⚔️ SELECT YOUR RACE ⚔️";
      }

      Label #Subtitle {
        Anchor: (Top: 5);
        Alignment: Center;
        Style: (FontSize: 14, TextColor: #a9a9a9);
        Text: "Choose wisely - your race defines your destiny";
      }
    }

    Group #Content {
      LayoutMode: Left;
      FlexWeight: 1;
      Padding: (Full: 15);

      Group #RaceListPanel {
        Anchor: (Width: 320);
        LayoutMode: TopScrolling;
        Padding: (Right: 12);
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }

      Group #RaceDetailPanel {
        FlexWeight: 1;
        LayoutMode: Top;
        Padding: (Full: 20);
        Background: #0f0f0f(0.9);
        BorderWidth: 2;
        BorderColor: #3a3a3a(0.6);
        CornerRadius: 8;

        Group #RaceHeader {
          LayoutMode: MiddleCenter;
          Anchor: (Height: 70);
          Padding: (Bottom: 15);
          BorderBottom: (Width: 2, Color: #2a2a2a);

          Label #RaceIcon {
            Anchor: (Height: 40);
            Alignment: Center;
            Style: (FontSize: 32);
            Text: "🧝";
          }

          Label #SelectedRaceName {
            Anchor: (Top: 5);
            Alignment: Center;
            Style: (FontSize: 22, RenderBold: true, TextColor: #ffffff);
            Text: "Elf";
          }

          Label #SelectedRaceTagline {
            Anchor: (Top: 3);
            Alignment: Center;
            Style: (FontSize: 13, TextColor: #b0b0b0, Italic: true);
            Text: "Agile and tireless, moves like the wind.";
          }
        }

        Group #StatsSection {
          LayoutMode: TopScrolling;
          FlexWeight: 1;
          Padding: (Top: 20);
          ScrollbarStyle: $C.@DefaultScrollbarStyle;

          Group #StrengthsSection {
            LayoutMode: Top;
            Anchor: (Bottom: 15);

            Label #StrengthsHeader {
              Anchor: (Height: 28);
              Padding: (Left: 8, Bottom: 8);
              Style: (FontSize: 15, RenderBold: true, TextColor: #5cc45c);
              Text: "✓ STRENGTHS";
            }

            Group #StrengthsList {
              LayoutMode: Top;
              Padding: (Left: 12);

              Label #PositiveLine1 {
                Anchor: (Height: 22);
                Style: (FontSize: 13, TextColor: #aaffaa);
                Text: "• Enhanced agility and speed";
              }

              Label #PositiveLine2 {
                Anchor: (Height: 22);
                Style: (FontSize: 13, TextColor: #aaffaa);
                Text: "• Natural archery mastery";
              }

              Label #PositiveLine3 {
                Anchor: (Height: 22);
                Style: (FontSize: 13, TextColor: #aaffaa);
                Text: "• Forest affinity bonus";
              }
            }
          }

          Group #WeaknessesSection {
            LayoutMode: Top;
            Anchor: (Top: 10);

            Label #WeaknessesHeader {
              Anchor: (Height: 28);
              Padding: (Left: 8, Bottom: 8);
              Style: (FontSize: 15, RenderBold: true, TextColor: #d75f5f);
              Text: "✗ WEAKNESSES";
            }

            Group #WeaknessesList {
              LayoutMode: Top;
              Padding: (Left: 12);

              Label #NegativeLine1 {
                Anchor: (Height: 22);
                Style: (FontSize: 13, TextColor: #ffaaaa);
                Text: "• Lower physical strength";
              }

              Label #NegativeLine2 {
                Anchor: (Height: 22);
                Style: (FontSize: 13, TextColor: #ffaaaa);
                Text: "• Reduced endurance";
              }
            }
          }
        }
      }
    }

    Group #Footer {
      LayoutMode: Left;
      Anchor: (Height: 60);
      Padding: (Full: 15);
      Background: #0a0a0a(0.5);

      $C.@PageButton #PrevPageButton {
        Text: "← Previous";
      }

      Group {
        Anchor: (Width: 15);
      }

      Label #PageInfo {
        Anchor: (Width: 100);
        Alignment: Center;
        Style: (FontSize: 14, TextColor: #cccccc);
        Text: "Page 1 / 2";
      }

      Group {
        Anchor: (Width: 15);
      }

      $C.@PageButton #NextPageButton {
        Text: "Next →";
      }

      Group {
        FlexWeight: 1;
      }

      $C.@TextButton #ConfirmSelection {
        Anchor: (Width: 200, Height: 45);
        Text: "Confirm Selection ✓";
      }
    }
  }
}
